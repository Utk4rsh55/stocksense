{
  "version": 2,
  "installCommand": "cd Backend && npm install && cd ../Frontend && npm install",
  "buildCommand": "cd Frontend && npm run build",
  "outputDirectory": "Frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "Backend/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/products/:path*", "destination": "/api" },
    { "source": "/sales/:path*", "destination": "/api" },
    { "source": "/dashboard/:path*", "destination": "/api" },
    { "source": "/ai/:path*", "destination": "/api" },
    { "source": "/test-db", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
